# Copie para .env e SUBSTITUA os valores CHANGE_ME antes de iniciar.
DB_HOST=db
DB_PORT=5432
DB_NAME=agendaflow
DB_USER=agenda
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:3000
BUSINESS_NAME=Studio Aurora
BUSINESS_TIMEZONE=America/Sao_Paulo

# Opcional — sem configurar as notificações serão registradas como "skipped"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v26.0
# Modelos aprovados no WhatsApp Business com 3 variáveis (nome, serviço, data)
WA_TEMPLATE_CONFIRMATION=
WA_TEMPLATE_REMINDER=
WA_TEMPLATE_RESCHEDULE=
WA_TEMPLATE_CANCELLATION=
